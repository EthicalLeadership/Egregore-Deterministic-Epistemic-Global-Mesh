import torch
from safetensors import safe_open
import time, os

# Paths
base = "/media/kark/MODELS_2TB3/models/kimi-k2-base"
shard = "model-2-of-61.safetensors"
layer = 1
expert_id = 0

# Tensor names
prefix = f"model.layers.{layer}.mlp.experts.{expert_id}"
weight_name = f"{prefix}.gate_proj.weight"
scale_name = f"{prefix}.gate_proj.weight_scale_inv"

print(f"Loading {weight_name} from {shard}")

start = time.time()
with safe_open(os.path.join(base, shard), framework="pt", device="cpu") as f:
    # Load FP8 weight and scale_inv (both small tensors)
    weight_fp8 = f.get_tensor(weight_name)
    scale_inv = f.get_tensor(scale_name)

load_time = time.time() - start
print(f"Loaded in {load_time:.2f}s")
print(f"weight_fp8 dtype: {weight_fp8.dtype}, shape: {weight_fp8.shape}")
print(f"scale_inv dtype: {scale_inv.dtype}, shape: {scale_inv.shape}")

# Dequantize FP8 block-wise
# weight_fp8 is stored as uint8 / torch.float8_e4m3fn? Actually safetensors may load as uint8.
# If it's float8_e4m3fn, we can use .float(). If uint8, we need to reinterpret as float8.
# Transformers often saves FP8 as uint8 with a specific format. We'll try both.

if weight_fp8.dtype == torch.uint8:
    # Reinterpret as float8_e4m3fn
    weight_fp8 = weight_fp8.view(torch.float8_e4m3fn)
elif weight_fp8.dtype == torch.float8_e4m3fn:
    pass
else:
    print("Unexpected weight dtype:", weight_fp8.dtype)

weight_fp32 = weight_fp8.float()

# Block-wise dequantization: scale_inv shape is [ceil(rows/128), ceil(cols/128)]
# We need to broadcast scale_inv to match weight shape.
# For each block of 128x128, multiply by the corresponding scale.
rows, cols = weight_fp32.shape
block_r, block_c = 128, 128
n_r = (rows + block_r - 1) // block_r
n_c = (cols + block_c - 1) // block_c
# Pad scale_inv if necessary
scale_inv_expanded = scale_inv.unsqueeze(2).unsqueeze(3)  # [n_r, n_c, 1, 1]
# Repeat to block size and reshape to weight size
scale_full = scale_inv_expanded.repeat(1, 1, block_r, block_c)[:, :, :rows, :cols]
scale_full = scale_full.permute(0, 2, 1, 3).reshape(rows, cols)  # careful
# Simpler: create grid and use F.interpolate? We'll do manual loop for correctness.
scale_matrix = torch.zeros(rows, cols)
for i in range(n_r):
    for j in range(n_c):
        r0, r1 = i*block_r, min((i+1)*block_r, rows)
        c0, c1 = j*block_c, min((j+1)*block_c, cols)
        scale_matrix[r0:r1, c0:c1] = scale_inv[i, j]

weight_dequant = weight_fp32 * scale_matrix

print(f"Dequantized weight dtype: {weight_dequant.dtype}, shape: {weight_dequant.shape}")

# Run a random input through gate_proj (input_dim = 7168)
input_dim = 7168
x = torch.randn(1, input_dim, dtype=torch.float32)
y = x @ weight_dequant.T  # [1, 2048]

print(f"Input shape: {x.shape}")
print(f"Output shape: {y.shape}")
print(f"First 5 output values: {y[0, :5].tolist()}")
print("Single expert computation successful.")
EOF
