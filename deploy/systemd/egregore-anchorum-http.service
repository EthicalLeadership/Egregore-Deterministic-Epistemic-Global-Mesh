[Unit]
Description=Egregore ANCHORUM Plain-HTTP Site
After=network.target
# ~/egregore physically lives on the blackstar HDD volume; do not start
# before that mount is up.
RequiresMountsFor=/mnt/blackstar/vol-hdd-a

[Service]
Type=simple
User=kark
Group=kark
WorkingDirectory=/home/kark/egregore
ExecStart=/home/kark/egregore/scripts/start_anchorum_http.sh
Restart=always
RestartSec=5

# Hardening
ProtectSystem=strict
ReadWritePaths=/home/kark/egregore
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
