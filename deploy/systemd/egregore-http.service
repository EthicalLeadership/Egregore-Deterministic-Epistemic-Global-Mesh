[Unit]
Description=Egregore Core HTTP API
Documentation=https://egregore.internal/docs
After=network-online.target
Wants=network-online.target
Requires=egregore-core.socket

[Service]
Type=notify
ExecStart=/opt/egregore/venv/bin/python -m uvicorn src.egregore.interfaces.http.main:app --host 127.0.0.1 --port 8080
WorkingDirectory=/opt/egregore
User=egregore
Group=egregore
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/egregore/logs /opt/egregore/data
ReadOnlyPaths=/opt/egregore/venv /opt/egregore/src
InaccessiblePaths=/root /home
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
MemoryMax=512M
TasksMax=50
LimitNOFILE=4096
UMask=0077
EnvironmentFile=-/etc/egregore/env

[Install]
WantedBy=multi-user.target
