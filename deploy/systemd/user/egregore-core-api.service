# /home/kark/.config/systemd/user/egregore-core-api.service
[Unit]
Description=Egregore Python Core API (port 8002)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/egregore
Environment=PYTHONPATH=src
EnvironmentFile=-%h/egregore/.env
ExecStart=%h/egregore/.venv/bin/python -m uvicorn egregore.http_api.http.main:app --host 0.0.0.0 --port 8002 --log-level info
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/egregore/logs/core-api.log
StandardError=append:%h/egregore/logs/core-api.log

[Install]
WantedBy=default.target
