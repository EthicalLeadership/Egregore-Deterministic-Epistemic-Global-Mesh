{
  "version": 1,
  "qc": {
    "fail_closed": true,
    "confidence_threshold": 0.7,
    "rework_budget": 2,
    "escalate_to": "heavy",
    "critic_timeout_ms": 15000,
    "critic_max_tokens": 256,
    "critic_model": "qwen_1.5b",
    "critic_temperature": 0.0,
    "deterministic_first": true,
    "max_output_chars": 50000,
    "forbidden_patterns": [
      "as an ai language model",
      "i cannot comply",
      "TODO: implement"
    ],
    "required_output_fields": ["module"],
    "required_output_fields_by_mode": {
      "case_report": ["summary"]
    }
  },
  "escalation": {
    "path": ["micro", "standard", "heavy"],
    "never_skip_station": true,
    "max_heavy_escalations_per_run": 1,
    "heavy_max_tokens": 4096,
    "heavy_temperature": 0.0
  }
}
