[Unit]
Description=Egregore Hardware Governance Layer
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
# Root required for GPU power limit control via NVML
User=root
WorkingDirectory=/opt/egregore
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/egregore/venv/bin/python3 /opt/egregore/src/egregore_hardware.py
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
