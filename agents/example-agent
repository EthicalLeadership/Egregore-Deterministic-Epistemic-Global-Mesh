#!/usr/bin/env python3
"""
Example Egregore CLI agent.

Receives the user's instruction as argv[1] and session context via the
BLACKSTAR_AGENT_CONTEXT environment variable. Relevant API keys are forwarded
from the chat server so the agent can call Claude, Kimi, DeepSeek, etc.

Expected usage from chat:
  /agent example-agent summarize the latest evidence
"""
from __future__ import annotations

import json
import os
import sys


def main() -> int:
    instruction = sys.argv[1] if len(sys.argv) > 1 else ""
    context_json = os.environ.get("BLACKSTAR_AGENT_CONTEXT", "{}")
    try:
        context = json.loads(context_json)
    except json.JSONDecodeError:
        context = {}

    # Example: an agent could call Claude/Kimi/OpenAI here using forwarded keys.
    # For the scaffold, echo a structured acknowledgement.
    response = {
        "agent": "example-agent",
        "instruction": instruction,
        "context": context,
        "note": "This is a scaffold agent. Replace this logic with Claude/Kimi calls.",
        "available_keys": [
            k for k in ("ANTHROPIC_API_KEY", "DEEPSEEK_API_KEY", "KIMI_API_KEY", "OPENAI_API_KEY")
            if os.environ.get(k)
        ],
    }
    print(json.dumps(response, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
