#!/opt/egregore/.venv/bin/python3
"""
Claude agent for Egregore Chat.

Receives an instruction from the chat, calls the Anthropic Messages API,
and returns Claude's response.

Requires ANTHROPIC_API_KEY in the environment (loaded from .env by the server).
"""
from __future__ import annotations

import json
import os
import sys
from typing import Any, Dict, List

import httpx


DEFAULT_MODEL = "claude-3-5-sonnet-20241022"
DEFAULT_BASE_URL = "https://api.anthropic.com"


def load_context() -> Dict[str, Any]:
    raw = os.environ.get("BLACKSTAR_AGENT_CONTEXT", "{}")
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


def call_claude(instruction: str, context: Dict[str, Any]) -> str:
    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not api_key:
        return "Error: ANTHROPIC_API_KEY is not configured. Add it to /opt/egregore/.env and restart egregore-dashboard.service."

    base_url = os.environ.get("ANTHROPIC_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
    model = os.environ.get("ANTHROPIC_AGENT_MODEL", DEFAULT_MODEL)

    session_id = context.get("session_id", "unknown")
    user_id = context.get("user_id", "unknown")
    role = context.get("role", "unknown")

    system_prompt = (
        "You are Egregore, a deterministic AI assistant helping a legal/intelligence operator. "
        "Be concise, accurate, and helpful. "
        f"Current operator: {user_id} (role: {role}, session: {session_id})."
    )

    headers = {
        "x-api-key": api_key,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json",
    }

    payload: Dict[str, Any] = {
        "model": model,
        "max_tokens": 4096,
        "system": system_prompt,
        "messages": [{"role": "user", "content": instruction}],
        "temperature": 0.7,
    }

    try:
        with httpx.Client(base_url=base_url, headers=headers, timeout=120.0) as client:
            r = client.post("/v1/messages", json=payload)
            r.raise_for_status()
            data = r.json()

            content = ""
            for block in data.get("content", []):
                if block.get("type") == "text":
                    content += block.get("text", "")

            if not content:
                return "Error: Claude returned an empty response."
            return content
    except httpx.HTTPStatusError as exc:
        return f"Error: Anthropic API returned {exc.response.status_code}: {exc.response.text}"
    except httpx.RequestError as exc:
        return f"Error: Could not reach Anthropic API: {exc}"
    except Exception as exc:
        return f"Error: {exc}"


def main() -> int:
    instruction = sys.argv[1] if len(sys.argv) > 1 else ""
    if not instruction:
        print("Usage: claude-agent <instruction>", file=sys.stderr)
        return 1

    context = load_context()
    response = call_claude(instruction, context)
    print(response)
    return 0


if __name__ == "__main__":
    sys.exit(main())
